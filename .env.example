# Creator OS pilot — server-side configuration.
# Copy to .env.local and fill in. NEVER commit .env.local and NEVER put these
# values in browser code, localStorage, or a client bundle.

# ---------------------------------------------------------------- inference
# Any OpenAI-compatible endpoint. LM Studio local development:
#   AI_BASE_URL=http://127.0.0.1:1234/v1
#   AI_MODEL=<the model id LM Studio shows, e.g. a loaded local model>
#   AI_API_KEY=            (leave empty; loopback endpoints need no key)
#
# A remote OpenAI-compatible provider (BYOK):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=<provider/model-id>
#   AI_API_KEY=<your key>
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional. Usually inferred from AI_BASE_URL. Values: lmstudio | openai-compatible | openrouter
AI_PROVIDER=
# Optional. Defaults to 60000.
AI_TIMEOUT_MS=
# Optional generation tuning. Defaults: AI_TEMPERATURE=0.2, AI_MAX_TOKENS=900.
# Small local models need a low temperature to hold the JSON shape.
AI_TEMPERATURE=
AI_MAX_TOKENS=
# Optional. 'auto' (default) requests grammar-constrained JSON via
# response_format and retries once against the SAME endpoint without it if the
# server rejects that parameter. 'on' always requests it, 'off' never does.
# This is parameter compatibility, not a provider fallback.
AI_JSON_MODE=
# Optional. Token budget for one Social Studio / Marketplace draft generation.
# When unset the code picks 1400 for a social post and 2600 for an offer draft,
# because an offer carries title, pricing, features, audience and packages. Set
# this only if your model needs more room: a reply cut off at the cap arrives as
# truncated JSON, and the pilot then keeps the drafts the model finished and
# tells you the rest were cut short rather than inventing them.
AI_DRAFT_MAX_TOKENS=

# Older aliases, still read if the AI_* names are absent:
# PILOT_MODEL_BASE_URL, PILOT_MODEL_ID, PILOT_MODEL_API_KEY, PILOT_MODEL_PROVIDER, PILOT_MODEL_TIMEOUT_MS

# ------------------------------------------------------------------- storage
# SQLite file holding all pilot users, projects, conversations, messages,
# next actions and remembered facts. Defaults to ./data/pilot.sqlite
PILOT_DB_PATH=

# --------------------------------------------------------------------- app
# Public URL of this app, used for the MCP endpoint and OpenRouter referer.
PILOT_APP_URL=http://localhost:3100

# Port for the MCP server process that Hermes/eve connects to.
PILOT_MCP_PORT=3101

# Set to 'true' when this service runs on a host that is NOT your laptop.
# Refuses a loopback AI_BASE_URL in that case, because on a hosted server
# localhost is the server itself and cannot reach your local LM Studio.
PILOT_HOSTED=

# Escape hatch only. Set 'true' to allow a loopback model endpoint while hosted.
PILOT_ALLOW_LOOPBACK_MODEL=

# --------------------------------------------------------------- publishing
# Social publishing is GATED OFF. /api/buffer can really create a Buffer post,
# so it refuses every call with 403 unless this is 'true'. Nothing is published
# during the pilot.
PILOT_PUBLISHING_ENABLED=
# Read on the server only. The browser never holds it and the route rejects a
# key that arrives in a request body.
BUFFER_API_KEY=

# ----------------------------------------------------------------- telegram
# Delivery is GATED OFF by default. While gated, outbound messages are written
# to the telegram_outbox table labelled gateway='mock' and nothing is sent.
# Set both values to enable real delivery during an authorised test only.
PILOT_TELEGRAM_SEND_ENABLED=
PILOT_TELEGRAM_BOT_TOKEN=

# The eve agent runtime validates inbound webhooks with this shared secret.
PILOT_TELEGRAM_WEBHOOK_SECRET=
